# Copy this file's values into your host's secret manager (Render/Railway/Fly env vars,
# or a local .env if you use a loader) — never commit real secrets to git.

# --- Server ---
PORT=3000
HOST=0.0.0.0
# sandbox = current mode. Do not change to a "live" mode until the real-money
# checklist in README.md is fully signed off.
WINZA_MODE=sandbox

# --- Database (required) ---
# Any managed Postgres works — Supabase, Neon, Render Postgres, etc. Apply schema.sql to it first.
DATABASE_URL=postgres://user:password@host:5432/winza
# Set to "true" once your provider's connection requires TLS (most managed Postgres hosts do).
DATABASE_SSL=true

# --- Auth secrets (required) ---
# 32+ random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_output_of_the_command_above

# Exactly 32 raw bytes, base64-encoded — used to encrypt stored MFA (TOTP) secrets.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=replace_with_output_of_the_command_above

# --- Optional ---
# If unset, password-reset tokens are still created in the database, but no email
# is sent — testers who try "forgot password" won't get an email until this points
# at a real mail-sending endpoint (e.g. a small serverless function calling Resend/Postmark).
PASSWORD_RESET_WEBHOOK_URL=

# If unset, OTP codes aren't actually sent anywhere — in non-live modes the code
# is echoed back in the API response instead, purely so you can test registration
# and login before an SMS provider is wired in. Point this at a webhook that calls
# your real SMS provider (Termii, Africa's Talking, Twilio, etc.) before going live —
# the devCode echo is structurally disabled once WINZA_MODE=live.
OTP_SMS_WEBHOOK_URL=

# --- Payments ---
# Absolute origin this server is reachable at (e.g. https://winza.onrender.com),
# used to build the callback/webhook URLs handed to Paystack and OPay. Only
# needed behind a proxy/CDN that doesn't forward a usable Host header —
# otherwise this is derived from the incoming request automatically.
APP_BASE_URL=

# Paystack (https://dashboard.paystack.com/#/settings/developer). Leave unset
# to keep Paystack deposits hidden from players. Use sk_test_.../pk_test_...
# until WINZA_MODE=live and you've gone through the real-money checklist below.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Set this to the same value in Paystack's dashboard webhook config
# (Settings > API Keys & Webhooks) pointed at:
#   <APP_BASE_URL>/api/v1/payments/webhook/paystack

# OPay merchant Cashier API (issued from your OPay merchant dashboard once
# approved). Leave unset to keep OPay deposits hidden from players — the app
# runs fine with only Paystack configured, or neither.
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
# Point OPay's webhook config at:
#   <APP_BASE_URL>/api/v1/payments/webhook/opay
