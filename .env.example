# Copy this file's values into your host's secret manager (Render/Railway/Fly env vars,
# or a local .env if you use a loader) — never commit real secrets to git.

# --- Server ---
PORT=3000
HOST=0.0.0.0
# sandbox = current mode. Do not change to a "live" mode until the real-money
# checklist in README.md is fully signed off.
WINZA_MODE=sandbox

# --- Database (required) ---
# Any managed Postgres works — Supabase, Neon, Render Postgres, etc. Apply schema.sql to it first.
DATABASE_URL=postgres://user:password@host:5432/winza
# Set to "true" once your provider's connection requires TLS (most managed Postgres hosts do).
DATABASE_SSL=true

# --- Auth secrets (required) ---
# 32+ random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_output_of_the_command_above

# Exactly 32 raw bytes, base64-encoded — used to encrypt stored MFA (TOTP) secrets.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=replace_with_output_of_the_command_above

# --- Optional ---
# If unset, password-reset tokens are still created in the database, but no email
# is sent — testers who try "forgot password" won't get an email until this points
# at a real mail-sending endpoint (e.g. a small serverless function calling Resend/Postmark).
PASSWORD_RESET_WEBHOOK_URL=

# If unset, OTP codes aren't actually sent anywhere. Point this at a webhook
# that calls your real SMS provider (Termii, Africa's Talking, Twilio, etc.)
# before this deployment is reachable by real users — WINZA_MODE stays
# "sandbox" through the Play Store launch, so it does NOT gate this.
OTP_SMS_WEBHOOK_URL=

# Local/dev testing only. When "true" AND OTP_SMS_WEBHOOK_URL is unset AND
# WINZA_MODE is not "live", OTP codes are echoed back in the API response so
# you can test registration/login without a real SMS provider. Leave this
# UNSET in any deployment real users can reach (including the sandbox Play
# Store build) — if it's on, anyone can request an OTP for any phone number
# and read the code straight back out of the response.
OTP_DEV_ECHO=

# If unset, KYC approval has no sanctions/PEP screening provider to check
# against — staff can still approve, but must supply an explicit
# sanctionsScreeningOverrideReason (10+ characters, logged) acknowledging the
# submission was not automatically screened. Point this at a webhook that
# calls your real screening provider (ComplyAdvantage, Refinitiv World-Check,
# a national sanctions-list API, etc.) before real-money launch — it should
# respond with JSON { hit: boolean, detail?: string }. See sanctions.js.
SANCTIONS_SCREENING_WEBHOOK_URL=

# --- Payments (Paystack) ---
# Deposits stay disabled unless BOTH WINZA_MODE=live AND this is set — see
# paystack.js and the /api/v1/wallet/deposits/initiate handler in server.js.
# Get this from your Paystack dashboard. Do not set it in sandbox — there is
# no reason to, since deposits are gated behind WINZA_MODE=live regardless.
PAYSTACK_SECRET_KEY=

# Same key, used to verify that a webhook POST to /api/v1/webhooks/paystack
# actually came from Paystack (HMAC-SHA512 over the raw body). This IS
# PAYSTACK_SECRET_KEY, not a separate value — Paystack doesn't issue a
# distinct webhook secret. Configure the webhook URL itself in the Paystack
# dashboard: https://your-domain/api/v1/webhooks/paystack

# Optional. Where Paystack redirects the player after checkout completes.
# If unset, Paystack falls back to whatever's configured on your dashboard.
# Set this to <your-domain>/?deposit=return — winza.html shows a friendly
# "confirming your deposit" message on that exact query string and refreshes
# the wallet balance. The actual crediting already happened (or didn't) via
# the webhook by this point; this page is not what decides success/failure.
PAYSTACK_CALLBACK_URL=

# --- Payments (OPay) ---
# Same gating principle as Paystack: deposits via OPay stay disabled unless
# BOTH WINZA_MODE=live AND all three of these are set — see opay.js and the
# same /api/v1/wallet/deposits/initiate handler (provider: "opay"). Issued
# from your OPay merchant dashboard once approved. Do not set these in
# sandbox — there's no reason to, since they're gated behind WINZA_MODE=live
# regardless. Paystack and OPay are independent — set either, both, or
# neither.
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=

# Used to verify that a webhook POST to /api/v1/webhooks/opay actually came
# from OPay (HMAC-SHA512 over the raw body, per OPay's Cashier API — see the
# caveat on this in README.md, since this environment couldn't reach OPay's
# docs site to confirm field-by-field). Configure the webhook URL itself in
# the OPay merchant dashboard: https://your-domain/api/v1/webhooks/opay

# Optional. Where OPay redirects the player after checkout completes.
# If unset, OPay falls back to whatever's configured on your dashboard. Same
# recommendation as PAYSTACK_CALLBACK_URL: <your-domain>/?deposit=return.
OPAY_CALLBACK_URL=
